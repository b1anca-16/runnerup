<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/active_run_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp">


    <!-- States Cards: Time / Distance / Pace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp">

        <!-- Stat Cards: Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/ic_bg_card_dark"
            android:padding="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_time"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/run_activity_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <!-- Stat Cards: Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/ic_bg_card_dark"
            android:padding="10dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_distance"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <!-- Stat Cards: Pace -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/ic_bg_card_dark"
            android:padding="10dp"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_pace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/interval_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Finished Flag (hidden by default) -->
    <ImageView
        android:id="@+id/iv_finished_flag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_flag_24dp"
        android:visibility="gone"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"/>


    <TextView
        android:id="@+id/live_ranking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_ranking"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_participants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"/>

    <TableRow
        android:id="@+id/run_table_row1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/stop_button"
            style="@style/ButtonText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_red"
            android:text="@string/Cancel"
            android:drawableEnd="@drawable/ic_av_stop"
            android:drawablePadding="-32dp" />

        <Button
            android:id="@+id/leave_button"
            style="@style/BlueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/leave_run"
            android:visibility="gone" />

    </TableRow>

</LinearLayout>