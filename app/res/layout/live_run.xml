<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/active_run_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp">


    <!-- States Cards: Time / Distance / Pace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="14dp">

        <!-- Stat Cards: Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/ic_bg_card_dark"
            android:padding="10dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_time"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/run_activity_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <!-- Stat Cards: Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/ic_bg_card_dark"
            android:padding="10dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_distance"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/intervall_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginTop="3dp"/>

        </LinearLayout>

        <!-- Stat Cards: Pace -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/ic_bg_card_dark"
            android:padding="10dp"
            android:layout_marginStart="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_pace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/interval_pace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginTop="3dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Progress Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/ic_bg_card_dark"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/label_progress"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/tv_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/colorPrimaryFab"/>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:background="@drawable/bg_progress_track">

            <View
                android:id="@+id/v_progress_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_progress_fill"/>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                android:textColor="@color/colorPrimaryFab"/>

            <TextView
                android:id="@+id/tv_progress_remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/colorPrimaryFab"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Finished Screen (hidden by default) -->
    <LinearLayout
        android:id="@+id/layout_finish_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_finish_block"
        android:padding="16dp"
        android:layout_marginBottom="14dp"
        android:visibility="gone">

        <ImageView
            android:contentDescription="@null"
            android:id="@+id/iv_finished_flag"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_flag_24dp"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/finish_congrats_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#A5D6A7"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/finish_congrats_subtitle"
            android:textSize="15sp"
            android:textColor="#81C784"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_finish_counter"
                android:padding="10dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tv_finished_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#A5D6A7"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_finished"
                    android:textSize="12sp"
                    android:textColor="#81C784"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_finish_counter"
                android:padding="10dp"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_running_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#A5D6A7"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_still_running"
                    android:textSize="15sp"
                    android:textColor="#81C784"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


    <!-- Live Ranking Label -->
    <TextView
        android:id="@+id/live_ranking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_ranking"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/colorText"
        android:letterSpacing="0.08"
        android:layout_marginBottom="10dp"/>

    <!-- Ranking List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_participants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp"/>

    <!-- Cancel Button (während Lauf) -->
    <Button
        android:id="@+id/stop_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/Cancel"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@color/colorPrimaryFab"
        android:layout_marginTop="8dp"/>

    <!-- Leave Button (anzeige nach Finish, standardmäßig versteckt) -->
    <Button
        android:id="@+id/leave_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/leave_run"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@color/colorPrimary"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

</LinearLayout>