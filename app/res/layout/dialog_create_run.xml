<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_run"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_run_subtitle"
        android:textSize="14sp"
        android:textColor="#777777"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/et_player_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/your_nickname"
        android:autofillHints="username"
        android:inputType="textPersonName"
        android:layout_marginBottom="12dp"
        />

    <EditText
        android:id="@+id/et_run_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/run_name"
        android:inputType="text"
        android:autofillHints="no"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/et_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/run_distance"
        android:inputType="numberDecimal"
        android:autofillHints="no"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/BlueButton"
            android:layout_width="wrap_content"
            android:drawableStart="@drawable/ic_cancel_white_24dp"
            android:layout_height="wrap_content"
            android:text="@string/Cancel"/>

        <Button
            android:id="@+id/btn_confirm"
            style="@style/BlueButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_add_white_24dp"
            android:text="@string/Create"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>