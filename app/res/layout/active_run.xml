<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/active_run_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="72dp"
    android:paddingBottom="28dp"
    android:padding="32dp">

    <!-- Run name -->
    <TextView
        android:id="@+id/tv_run_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:text="@string/run_name"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <!-- Join code -->
    <TextView
        android:layout_width="183dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/code_placeholder"
        android:textColor="#FFF"
        android:textSize="25sp"
        android:textStyle="bold" />

    <!-- Active since -->
    <TableRow
        android:id="@+id/run_table_row3"
        android:layout_width="fill_parent"
        android:layout_height="36dp"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/tv_active_since_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/run_active_since"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/run_activity_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />
    </TableRow>

    <!-- Distance -->
    <TableRow
        android:id="@+id/run_table_row4"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/tv_distance_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/distance"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/intervall_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />
    </TableRow>

    <!-- Pace -->
    <TableRow
        android:id="@+id/run_table_row2"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="25dp">

    <TextView
        android:id="@+id/tv_pace_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pace"
        android:textColor="#FFFFFF"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/interval_pace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:layout_marginStart="7dp"
        android:textSize="25sp" />
    </TableRow>


    <TextView
        android:id="@+id/live_ranking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/live_ranking"
        android:textColor="#FFFFFF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginBottom="15dp"
        />


    <ListView
        android:id="@+id/lv_participants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:divider="1dp"
        android:dividerHeight="1dp"/>

    <TableRow
        android:id="@+id/run_table_row1"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/run_table_row2" >

        <Button
            android:id="@+id/pause_button"
            style="@style/ButtonText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_green"
            android:text="@string/Pause"
            android:drawableEnd="@drawable/ic_av_pause"
            android:drawablePadding="-32dp" />

        <Button
            android:id="@+id/stop_button"
            style="@style/ButtonText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_red"
            android:text="@string/Stop"
            android:drawableEnd="@drawable/ic_av_stop"
            android:drawablePadding="-32dp" />

    </TableRow>

</LinearLayout>