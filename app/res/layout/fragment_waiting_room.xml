<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/waiting_room_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBottomNav"
    android:padding="20dp">

    <!-- Code + Distance -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/ic_bg_card_dark"
            android:padding="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_code"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/tv_token"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/ic_bg_card_dark"
            android:padding="14dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_distance"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimaryFab"
                android:letterSpacing="0.08"/>

            <TextView
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- GPS / Hourglass Status Block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:background="@drawable/ic_bg_divider_block">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_hour_glass_24dp"
            android:contentDescription="@string/hourglass"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/waiting_participants"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:letterSpacing="0.04"/>
    </LinearLayout>


    <!-- Participants Label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/participants"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimaryFab"
        android:letterSpacing="0.08"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="10dp"/>

    <!-- Participants List -->
    <ListView
        android:id="@+id/lv_participants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"/>

    <!-- Start Button -->
    <Button
        android:id="@+id/btn_start_run"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/Start_activity"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@color/colorPrimary"
        android:layout_marginTop="16dp"/>

</LinearLayout>